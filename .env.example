# LLM (OpenAI-compatible). Leave META_API_KEY empty to use the offline mock tutor.
META_API_BASE_URL=https://api.meta.ai/v1
META_API_KEY=
META_MODEL=muse-spark-1.3
# Muse Spark reasons before answering; reasoning tokens count against META_MAX_TOKENS.
META_REASONING_EFFORT=low
META_MAX_TOKENS=2000

# CORS origin of the web app
WEB_ORIGIN=http://localhost:5173

# Postgres (defaults match docker-compose.yml)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/arandu
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=
